NODE_ENV=development
PORT=4000

# Supabase connection string (Session pooler). URL-encode the password (e.g. @ -> %40).
DATABASE_URL=
DB_SSL=true

# Random string, at least 32 characters (openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Comma separated. URL(s) of the React app.
CORS_ORIGINS=http://localhost:5173

# Google Cloud Console -> OAuth Client ID (Web). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=

# These emails become admins when they log in
ADMIN_EMAILS=

# Cloudinary (free) for photo uploads. If empty, sellers paste image URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
